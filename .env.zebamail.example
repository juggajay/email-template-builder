# ZebaMail Production Environment Configuration
# Domain: https://www.zebamail.com

# === REQUIRED SETTINGS ===

# App URLs
NEXT_PUBLIC_APP_URL=https://www.zebamail.com
NEXT_PUBLIC_BASE_URL=https://www.zebamail.com
NODE_ENV=production

# Supabase (existing configuration)
NEXT_PUBLIC_SUPABASE_URL=https://uvcebvlmufytjxiysbhr.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Shopify Public App (new credentials)
SHOPIFY_CLIENT_ID=your-new-public-app-client-id
SHOPIFY_CLIENT_SECRET=your-new-public-app-client-secret

# Email Service
DEFAULT_FROM_EMAIL=noreply@zebamail.com
DEFAULT_FROM_NAME=ZebaMail

# Choose one email provider:
RESEND_API_KEY=your-resend-api-key
# OR
# SENDGRID_API_KEY=your-sendgrid-api-key

# === OPTIONAL SERVICES ===

# Stripe (when ready for payments)
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

# === SHOPIFY APP URLS ===
# Configure these in Shopify Partners Dashboard:
# 
# App URL: https://www.zebamail.com
# 
# Allowed redirection URLs:
# - https://www.zebamail.com/api/shopify/callback
# - https://zebamail.com/api/shopify/callback
# - http://localhost:3000/api/shopify/callback
#
# Webhooks URL:
# - https://www.zebamail.com/api/shopify/webhooks