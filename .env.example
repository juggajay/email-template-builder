# Database
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Authentication
NEXTAUTH_SECRET=your_nextauth_secret
NEXTAUTH_URL=http://localhost:3000

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# Email Editor
UNLAYER_PROJECT_ID=your_unlayer_project_id
UNLAYER_API_KEY=your_unlayer_api_key

# Image Storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email Service
RESEND_API_KEY=your_resend_api_key

# Vector Search
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_ENVIRONMENT=your_pinecone_environment

# Email Platform APIs
KLAVIYO_API_KEY=your_klaviyo_api_key
MAILCHIMP_API_KEY=your_mailchimp_api_key
OMNISEND_API_KEY=your_omnisend_api_key
CONSTANT_CONTACT_CLIENT_ID=your_constant_contact_client_id
CONSTANT_CONTACT_CLIENT_SECRET=your_constant_contact_client_secret

# E-commerce Platform APIs
SHOPIFY_API_KEY=your_shopify_api_key
SHOPIFY_API_SECRET=your_shopify_api_secret
WOOCOMMERCE_CONSUMER_KEY=your_woocommerce_consumer_key
WOOCOMMERCE_CONSUMER_SECRET=your_woocommerce_consumer_secret

# Development
NODE_ENV=development
PORT=3000

# Analytics (Optional)
GOOGLE_ANALYTICS_ID=your_ga_id
MIXPANEL_TOKEN=your_mixpanel_token

# Feature Flags (Optional)
FEATURE_FLAG_AI_SUGGESTIONS=true
FEATURE_FLAG_COLLABORATION=false
FEATURE_FLAG_WHITE_LABEL=false