{
  "name": "zebamail",
  "version": "0.1.2",
  "private": true,
  "sideEffects": false,
  "scripts": {
    "dev": "next dev",
    "build": "npm run build:clean && npm run build:check && npm run build:next && npm run postbuild",
    "build:clean": "rimraf .next out",
    "build:check": "npm run type-check && npm run lint",
    "build:next": "cross-env NODE_ENV=production next build",
    "build:analyze": "cross-env ANALYZE=true npm run build",
    "build:analyze:server": "cross-env BUNDLE_ANALYZE=server npm run build",
    "build:analyze:browser": "cross-env BUNDLE_ANALYZE=browser npm run build",
    "build:experimental": "npm run build:clean && cross-env NODE_ENV=production EXPERIMENTAL=true next build",
    "postbuild": "npm run sitemap && npm run size",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "type-check": "tsc --noEmit",
    "type-check:watch": "tsc --noEmit --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "size": "size-limit",
    "size:why": "size-limit --why",
    "sitemap": "next-sitemap",
    "analyze:sourcemap": "source-map-explorer .next/static/**/*.js",
    "analyze:deps": "npx depcheck",
    "build:info": "node scripts/build-info.js",
    "clean": "rimraf .next out coverage .turbo",
    "clean:all": "npm run clean && rimraf node_modules",
    "preinstall": "npx only-allow npm",
    "prepare": "husky install || true",
    "test:performance": "node scripts/test-performance.js",
    "lighthouse": "lhci autorun",
    "lighthouse:local": "npm run build && npm run export && lhci autorun"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.3.2",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-radio-group": "^1.3.7",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-toast": "^1.2.14",
    "@shopify/admin-api-client": "^1.1.0",
    "@stripe/react-stripe-js": "^2.4.0",
    "@stripe/stripe-js": "^2.2.0",
    "@supabase/auth-helpers-nextjs": "^0.8.7",
    "@supabase/supabase-js": "^2.38.4",
    "@tanstack/react-query": "^5.8.4",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "dataloader": "^2.2.3",
    "date-fns": "^2.30.0",
    "framer-motion": "^10.16.16",
    "immer": "^10.1.1",
    "jszip": "^3.10.1",
    "juice": "^11.0.1",
    "lru-cache": "^11.1.0",
    "lucide-react": "^0.294.0",
    "next": "^14.2.5",
    "puppeteer": "^24.13.0",
    "puppeteer-core": "^24.13.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-email-editor": "^1.7.8",
    "react-hook-form": "^7.48.2",
    "react-virtualized-auto-sizer": "^1.0.26",
    "react-window": "^1.8.11",
    "sonner": "^1.7.4",
    "stripe": "^14.7.0",
    "tailwind-merge": "^2.0.0",
    "tailwindcss-animate": "^1.0.7",
    "web-vitals": "^5.0.3",
    "zod": "^3.22.4",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^15.4.3",
    "@playwright/mcp": "^0.0.30",
    "@playwright/test": "^1.54.1",
    "@size-limit/file": "^11.2.0",
    "@testing-library/jest-dom": "^6.1.4",
    "@testing-library/react": "^14.1.2",
    "@types/node": "^20.9.0",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@types/react-virtualized-auto-sizer": "^1.0.4",
    "@types/react-window": "^1.8.8",
    "@typescript-eslint/eslint-plugin": "^6.12.0",
    "@typescript-eslint/parser": "^6.12.0",
    "autoprefixer": "^10.4.16",
    "cross-env": "^7.0.3",
    "eslint": "^8.54.0",
    "eslint-config-next": "^14.2.5",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "next-sitemap": "^4.2.3",
    "postcss": "^8.4.31",
    "prettier": "^3.1.0",
    "prettier-plugin-tailwindcss": "^0.5.7",
    "rimraf": "^6.0.1",
    "size-limit": "^11.2.0",
    "source-map-explorer": "^2.5.3",
    "tailwindcss": "^3.3.5",
    "typescript": "^5.3.2"
  }
}
