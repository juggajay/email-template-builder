# Production Environment Variables - SECURITY CONFIGURATION
# Copy this file to .env.production and fill in your actual values

# === REQUIRED SECURITY SETTINGS ===

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe Configuration
STRIPE_SECRET_KEY=sk_live_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_your-publishable-key

# Email Service Configuration
EMAIL_SERVICE_PROVIDER=sendgrid # or 'resend'
SENDGRID_API_KEY=your-sendgrid-api-key
RESEND_API_KEY=your-resend-api-key

# Default Email Settings
DEFAULT_FROM_EMAIL=noreply@yourdomain.com
DEFAULT_FROM_NAME=Your Company Name

# === SECURITY SETTINGS ===

# Session Security
SESSION_SECRET=your-long-random-session-secret
SECURE_COOKIES=true

# CORS Configuration
ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com

# Rate Limiting
RATE_LIMIT_API_MAX=100
RATE_LIMIT_API_WINDOW=900000
RATE_LIMIT_AUTH_MAX=5
RATE_LIMIT_AUTH_WINDOW=900000
RATE_LIMIT_EMAIL_MAX=50
RATE_LIMIT_EMAIL_WINDOW=3600000

# Content Security Policy
CSP_REPORT_URI=https://your-csp-report-endpoint.com

# === MONITORING & LOGGING ===

# Error Tracking
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_AUTH_TOKEN=your-sentry-auth-token
SENTRY_ORG=your-org
SENTRY_PROJECT=your-project

# Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
LOGROCKET_APP_ID=your-logrocket-app-id

# === SHOPIFY INTEGRATION ===

# Shopify App Configuration
SHOPIFY_APP_API_KEY=your-shopify-api-key
SHOPIFY_APP_API_SECRET=your-shopify-api-secret
SHOPIFY_APP_SCOPES=read_products,write_products,read_customers,write_customers,read_orders

# === WEBHOOK SECRETS ===

# Webhook Verification Keys
SENDGRID_WEBHOOK_VERIFICATION_KEY=your-sendgrid-webhook-key
SHOPIFY_WEBHOOK_SECRET=your-shopify-webhook-secret

# === API KEYS ===

# External Service API Keys
UNLAYER_API_KEY=your-unlayer-api-key

# === DEPLOYMENT ===

# Deployment Configuration
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://yourdomain.com

# === PERFORMANCE ===

# Cache Configuration
REDIS_URL=redis://your-redis-instance:6379
CACHE_TTL=3600

# === SECURITY HEADERS ===

# HSTS Configuration
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true
HSTS_PRELOAD=true

# === NOTES ===
# 1. Never commit this file with actual values
# 2. Use strong, unique values for all secrets
# 3. Rotate secrets regularly
# 4. Use environment-specific values
# 5. Enable all security features in production