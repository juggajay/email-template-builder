# Minimal Production Environment Variables for Vercel
# These are the REQUIRED variables to get the app running

# === REQUIRED SUPABASE SETTINGS ===
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# === REQUIRED APP SETTINGS ===
NEXT_PUBLIC_APP_URL=https://your-vercel-app.vercel.app
NODE_ENV=production

# === EMAIL SERVICE (At least one required) ===
# Option 1: Resend (Recommended for getting started)
RESEND_API_KEY=your-resend-api-key

# Option 2: SendGrid
# SENDGRID_API_KEY=your-sendgrid-api-key

# === DEFAULT EMAIL SETTINGS ===
DEFAULT_FROM_EMAIL=noreply@yourdomain.com
DEFAULT_FROM_NAME=Your App Name

# === OPTIONAL SERVICES (Can be added later) ===
# Stripe (for payments)
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

# Shopify (for e-commerce integration - Public App)
# SHOPIFY_CLIENT_ID=your-public-app-client-id
# SHOPIFY_CLIENT_SECRET=your-public-app-client-secret

# === NOTES FOR VERCEL DEPLOYMENT ===
# 1. Go to your Vercel project settings
# 2. Navigate to "Environment Variables"
# 3. Add each of these variables
# 4. Make sure to select "Production" environment
# 5. The SUPABASE_SERVICE_ROLE_KEY should be kept secret