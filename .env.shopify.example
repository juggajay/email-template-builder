# Shopify Public App Configuration Example
# Use this as a reference when setting up your Shopify Public App

# IMPORTANT: These must be from a PUBLIC APP, not a Custom App!
# Custom Apps cannot be distributed or charge merchants

# Your Public App credentials from Shopify Partners Dashboard
SHOPIFY_CLIENT_ID=1234567890abcdef1234567890abcdef
SHOPIFY_CLIENT_SECRET=shpss_1234567890abcdef1234567890abcdef
SHOPIFY_APP_HANDLE=your-app-handle  # From Shopify Partners Dashboard

# Base URL for OAuth callbacks (update for production)
NEXT_PUBLIC_BASE_URL=https://your-app.vercel.app

# OAuth Redirect URLs to configure in Shopify App Settings:
# - https://your-app.vercel.app/api/shopify/callback
# - http://localhost:3000/api/shopify/callback (for development)

# Webhook URL to configure in Shopify App Settings:
# - https://your-app.vercel.app/api/shopify/webhooks

# Required OAuth Scopes (configured in code, not env):
# - read_products, write_products
# - read_customers, write_customers
# - read_orders, write_orders
# - read_checkouts, write_checkouts
# - read_inventory, write_inventory

# Notes:
# 1. Never commit real credentials to git
# 2. Use separate apps for development and production
# 3. See SHOPIFY_APP_MIGRATION_GUIDE.md for full setup instructions